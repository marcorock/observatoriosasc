<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - {{system}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/main/css/style.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    
    <style>
        /* 1. AUMENTANDO OS TÍTULOS E NÚMEROS DOS CARDS */
        .summary-label { 
            font-size: 1.1rem !important; 
            font-weight: 800 !important; 
            letter-spacing: 0.5px; 
            color: #94a3b8; /* var(--muted-text) */
            text-transform: uppercase; 
            margin-bottom: 4px; 
        }
        .summary-value { 
            font-size: 2.2rem !important; 
            font-weight: 800; 
            line-height: 1; 
        }

        /* 2. LETRAS MAIORES PARA A TABELA (MODO TV) */
        .tv-table-large th { 
            font-size: 1.1rem !important; 
            padding: 16px !important; 
            color: #94a3b8; 
        }
        .tv-table-large td { 
            font-size: 1.45rem !important; 
            font-weight: 600; 
            padding: 20px 16px !important; 
        }

        /* 3. ANIMAÇÃO SUAVE AO TROCAR DE TELA */
        .fade-in { animation: fadeIn 0.4s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>

<div class="container-fluid full-hd-container">
    
        <!--FIRST-LINE-HEADER-APPLICATION-->
        {% block header %}    
            <header class="row mb-3 g-2">
                <div class="col-12">
                    <div class="card-custom p-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h4 class="mb-0">MODO TV: {{title}}</h4>
                                <small class="text-secondary">{{description}}</small>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <div class="row g-2 justify-content-md-end align-items-center">
                                    <div class="col-auto"><span class="badge bg-primary">Mês: Setembro</span></div>
                                    <div class="col-auto"><span class="badge bg-success">Status: Ativo</span></div>
                                    
                                    <!-- BOTÃO PARA ALTERNAR AS TELAS -->
                                    <div class="col-12 mt-2">
                                        <button id="viewToggleBtn" class="btn btn-outline-info btn-sm fw-bold w-100" type="button">
                                            Alternar para Tabela
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        {% endblock header %}

        <!--SECOND-LINE-CARDS-TOTAL-->
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-3">
        {% block cards %}
                <div class="col">
                    <div class="card-custom p-3 text-center">
                        <small class="summary-label">TOTAL </small>
                        <h2 class="summary-value">{{dados.total_geral ?? NULL}}</h2>
                    </div>
                </div>
                {% for row in dados.situacao %}
                    {% if row.situacao == 'Concluído' %}  
                        <div class="col">
                            <div class="card-custom p-3 text-center border-start border-primary border-4">
                                <small class="summary-label">{{row.situacao}}</small>
                                <h2 class="summary-value text-success">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}   
                    {% if row.situacao == 'Em andamento' %}      
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="summary-label">{{row.situacao}}</small>
                                <h2 class="summary-value text-warning">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %} 
                    {% if row.situacao == 'Não iniciado' %} 
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="summary-label">{{row.situacao}}</small>
                                <h2 class="summary-value text-danger">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endblock cards %}
        </div>  
        

        <!-- LINE-MAPS-GRAPHICS -->
        {% block graphics %}    


            <!-- TELA 1: APENAS GRÁFICOS -->
            <div id="view-graficos" class="row row-cols-1 row-cols-lg-2 g-3 mb-0 row-flexible fade-in">
                <!-- Gráfico de Pizza (Esquerda) -->
                <div class="col">
                    <div class="card-custom chart-card p-3 h-100">
                        <h6 style="font-size: 1.2rem; font-weight: 700;" class="mb-3">Distribuição Por Status</h6>
                        <div class="chart-viewport" style="min-height: 300px;">
                            <canvas id="graficoEixo"></canvas>
                        </div>
                    </div>
                </div>
                
                <!-- Gráfico de Barra (Direita) -->
                <div class="col">
                    <div class="card-custom chart-card p-3 h-100">
                        <h6 style="font-size: 1.2rem; font-weight: 700;" class="mb-3">Distribuição Por Eixo</h6>
                        <div class="chart-viewport" style="min-height: 300px;">
                            <canvas id="graficoEixoBar"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TELA 2: APENAS TABELA COM CARROSSEL  -->
            <div id="view-tabela" class="row row-flexible g-3 mb-3 d-none fade-in">
                <div class="col-12">
                    <div class="card-custom data-table-card p-4 h-100">
                        <div class="w-100">
                            <div class="data-table-header d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="data-table-title">Tabela de Dados BSC</h6>
                                    <span class="data-table-subtitle text-secondary">Apresentando no máximo 5 registros por tela</span>
                                </div>
                                <span class="badge bg-secondary" style="font-size: 1rem;">Total: {{ dados.registros|length }}</span>
                            </div>
                            
                            <!-- CARROSSEL BOOTSTRAP: Troca a cada 10s-->
                            <div id="tabelaCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="10000">
                                <div class="carousel-inner">
                                    
                                    {# O batch(6) divide o array de registros em grupos de 6 #}
                                    {% for pagina in dados.registros|batch(5) %}
                                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                                            <div class="table-responsive data-table-shell">
                                                <table class="table data-table tv-table-large align-middle mb-0 w-100">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">ID</th>
                                                            <th scope="col">Estratégia</th>
                                                            <th scope="col" class="text-center">Status</th>
                                                            <th scope="col" class="text-end">Data</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for row in pagina %}
                                                            {% set statusClasses = {
                                                                'Concluído': 'status-toast-success',
                                                                'Em andamento': 'status-toast-warning',
                                                                'Não iniciado': 'status-toast-danger',
                                                                'cancelado': 'status-toast-danger'
                                                            } %}
                                                            <tr class="bsc-data-row">
                                                                <td class="data-table-id text-info">#{{ row.id }}</td>
                                                                <td class="data-table-strategy">{{ row.estrategia|slice(0, 90) }}{{ row.estrategia|length > 90 ? '...' : '' }}</td>
                                                                <td class="text-center">
                                                                    <span class="status-toast {{ statusClasses[row.situacao] ?? 'bg-secondary' }} px-3 py-2 rounded">
                                                                        {{ row.situacao }}
                                                                    </span>
                                                                </td>
                                                                <td class="data-table-date text-end">{{ row.data_referencia ? row.data_referencia|date('d/m/Y') : '-' }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="text-center mt-3 text-secondary fw-bold">
                                                Página {{ loop.index }} de {{ loop.length }} (Mudando em 10s...)
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="text-center py-5 text-secondary">
                                            <h4>Nenhum registro encontrado.</h4>
                                        </div>
                                    {% endfor %}
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock graphics %}
</div>   

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@0.7.0"></script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="/assets/other/js/graficos.js"></script> <!--script para renderização de gráficos-->
    <script src="/assets/other/js/theme-manager.js"></script>

    <script>
        // JS DA ALTERNÂNCIA DE TELAS
        document.addEventListener('DOMContentLoaded', function() {
            const btnToggle = document.getElementById('viewToggleBtn');
            const viewGraficos = document.getElementById('view-graficos');
            const viewTabela = document.getElementById('view-tabela');
            
            let estadoAtual = 'graficos';

            if(btnToggle) {
                btnToggle.addEventListener('click', function() {
                    if(estadoAtual === 'graficos') {
                        viewGraficos.classList.add('d-none');
                        viewTabela.classList.remove('d-none');
                        btnToggle.innerHTML = 'Alternar para Gráficos';
                        estadoAtual = 'tabela';
                    } else {
                        viewTabela.classList.add('d-none');
                        viewGraficos.classList.remove('d-none');
                        btnToggle.innerHTML = 'Alternar para Tabela';
                        estadoAtual = 'graficos';
                    }
                });
            }
        });

        // DADOS DOS GRÁFICOS
        const grafico_eixo = {{ dados.situacao|json_encode|raw }};
        const isMobile = window.innerWidth <= 576;
        const pieOptions = isMobile
            ? { showLegend: false, datalabelOffset: 6 }
            : { showLegend: true, legendPosition: 'right', datalabelAnchor: 'center', datalabelAlign: 'center', datalabelOffset: 0, dataLabelFontSize: 15 };

        createChart('graficoEixo', grafico_eixo, 'situacao', 'pie', 'total', pieOptions);

        const grafico_eixoBar = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBar', grafico_eixoBar, 'eixo', 'bar', 'total', { showLegend: false });

        const grafico_eixoBarHorizon = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBarHorizon', grafico_eixoBarHorizon, 'eixo', 'horizontalBar', 'total', { showLegend: false, datalabelAlign: 'right' });
    </script>
    
    <script src="/assets/main/js/script.js"></script>
    {% block js %}{% endblock js %}
</body>
</html>