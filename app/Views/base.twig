<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - {{system}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    {# <link rel="stylesheet" href="/../public/assets/main/css/style.css"> #}

    {# <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script> #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <style>
        body {
            background-color: #0f172a; /* Tom escuro similar à imagem */
            color: #f8fafc;
        }
        .card-custom {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            height: 100%;
        }
        /* Ajuste para garantir preenchimento em telas 1080p */
        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }
            .row-flexible { flex: 1; }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
    </style>
    <style>
        :root {
            --app-bg: #0f172a;
            --app-text: #f8fafc;
            --card-bg: #1e293b;
            --card-border: #334155;
            --muted-text: #7f8aa3;
        }

        body {
            background-color: var(--app-bg);
            color: var(--app-text);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .card-custom {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            height: 100%;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .brand-subtitle,
        .meta-pill,
        .text-muted-custom {
            color: var(--muted-text);
        }

        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }

            .row-flexible {
                flex: 1;
            }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
        .theme-icon {
            font-size: 14px;
            line-height: 1;
        }

        .data-table-card {
            display: flex;
            min-height: 100%;
            overflow: hidden;
        }

        .data-table-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 18px;
        }

        .data-table-title {
            margin: 0;
            font-size: clamp(1.25rem, 1.45vw, 1.65rem);
            font-weight: 800;
            letter-spacing: 0;
        }

        .data-table-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--muted-text);
            font-size: clamp(0.9rem, 0.9vw, 1.05rem);
        }

        .data-table-page {
            min-width: 92px;
            padding: 8px 12px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.58);
            color: #dbeafe;
            font-size: clamp(0.95rem, 0.9vw, 1.1rem);
            font-weight: 700;
            text-align: center;
        }

        .data-table-shell {
            overflow-x: auto;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.45);
        }

        .data-table {
            min-width: 760px;
            border-collapse: separate;
            border-spacing: 0;
            color: var(--app-text);
        }

        .data-table thead th {
            padding: 16px 18px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.24);
            background: rgba(30, 41, 59, 0.92);
            color: #94a3b8;
            font-size: clamp(0.82rem, 0.82vw, 0.98rem);
            font-weight: 800;
            text-transform: uppercase;
        }

        .data-table tbody td {
            padding: 17px 18px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.12);
            font-size: clamp(1rem, 1vw, 1.18rem);
            vertical-align: middle;
        }

        .data-table tbody tr {
            background: rgba(30, 41, 59, 0.38);
        }

        .data-table tbody tr:nth-child(even) {
            background: rgba(51, 65, 85, 0.28);
        }

        .data-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .data-table-id {
            width: 72px;
            color: #93c5fd;
            font-weight: 800;
        }

        .data-table-strategy {
            max-width: 360px;
            color: #f8fafc;
            font-weight: 700;
            line-height: 1.28;
        }

        .data-table-axis,
        .data-table-date {
            color: #cbd5e1;
            font-weight: 650;
            white-space: nowrap;
        }

        .data-table-pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 16px;
        }

        .data-table-progress {
            flex: 1;
            height: 8px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.18);
        }

        .data-table-progress-bar {
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #38bdf8, #22c55e);
            transition: width 0.25s ease;
        }

        .data-table-actions {
            display: flex;
            gap: 8px;
        }

        .data-table-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.62);
            color: #e2e8f0;
            font-size: 1.35rem;
            line-height: 1;
        }

        .data-table-btn:hover,
        .data-table-btn:focus {
            border-color: rgba(56, 189, 248, 0.75);
            color: #7dd3fc;
        }

        .status-toast {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 146px;
            padding: 8px 12px;
            border-radius: 8px;
            border-left: 4px solid var(--bs-secondary);
            background: rgba(var(--bs-secondary-rgb), 0.18);
            color: var(--app-text);
            font-size: clamp(0.95rem, 0.9vw, 1.08rem);
            font-weight: 800;
            white-space: nowrap;
        }

        .status-toast-success {
            border-left-color: var(--bs-success);
            background: rgba(var(--bs-success-rgb), 0.18);
            color: #8ee6ad;
        }

        .status-toast-warning {
            border-left-color: var(--bs-warning);
            background: rgba(var(--bs-warning-rgb), 0.18);
            color: #ffe08a;
        }

        .status-toast-danger {
            border-left-color: var(--bs-danger);
            background: rgba(var(--bs-danger-rgb), 0.18);
            color: #ff9aa8;
        }

        @media (max-width: 991.98px) {
            .data-table-card {
                min-height: auto;
            }

            .data-table {
                min-width: 680px;
            }

            .data-table-header,
            .data-table-pagination {
                align-items: stretch;
                flex-direction: column;
            }

            .data-table-page {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<div class="container-fluid full-hd-container">
    {# {% block main %} #}
        <!--FIRST-LINE-HEADER-APPLICATION-->
        {% block header %}    
            <header class="row mb-3 g-2">
                <div class="col-12">
                    <div class="card-custom p-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h4 class="mb-0">MODO TV: {{title}}</h4>
                                <small class="text-secondary">{{description}}</small>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <div class="row g-2 justify-content-md-end">
                                    <div class="col-auto"><span class="badge bg-primary">Mês: Setembro</span></div>
                                    <div class="col-auto"><span class="badge bg-success">Status: Ativo</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        {% endblock header %}

        <!--SECOND-LINE-CARDS-TOTAL-->
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-3">
        {% block cards %}
                <div class="col">
                    <div class="card-custom p-3 text-center">
                        <small class="text-uppercase text-secondary">TOTAL </small>
                        <h2 class="fw-bold mb-0">{{dados.total_geral ?? NULL}}</h2>
                    </div>
                </div>
                {% for row in dados.situacao %}
                    {% if row.situacao == 'Concluído' %}  
                        <div class="col">
                            <div class="card-custom p-3 text-center border-start border-primary border-4">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-success">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}   
                    {% if row.situacao == 'Em andamento' %}      
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-warning">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %} 
                    {# Não iniciado #}
                    {% if row.situacao == 'Não iniciado' %} 
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-danger">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endblock cards %}
        </div>  
        

        <!-- LINE-MAPS-GRAPHICS -->
        <div class="row row-cols-1 row-cols-lg-2 g-3 mb-3 row-flexible">
            {% block graphics %}   
                <div class="col">

                    <div class="col">
                        <div class="card-custom p-3">
                            <h6>Distribuição Por eixo</h6>
                            <div class="d-flex align-items-center justify-content-center" style="min-height: 300px;">
                                <canvas id="graficoEixo"></canvas>
                                {# graficoEixoBar #}
                            </div>
                        </div>
                    </div>
                    <div class="col mt-3">
                        <div class="card-custom p-3">
                            <h6>Distribuição Por eixo</h6>
                            <div class="d-flex align-items-center justify-content-center" style="min-height: 350px;">
                                <canvas id="graficoEixoBar"></canvas>
                            </div>
                        </div>
                    </div>

                </div> 

                <div class="col">
                    <div class="card-custom data-table-card p-3">
                        <div class="w-100">
                            <div class="data-table-header">
                                <div>
                                    <h6 class="data-table-title">Tabela de dados</h6>
                                    <span class="data-table-subtitle">{{ dados.registros|length }} registros acompanhados</span>
                                </div>
                                <div class="data-table-page" id="bscTablePageInfo">1/1</div>
                            </div>
                            <div class="table-responsive data-table-shell">
                            <table class="table data-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">ID</th>
                                        <th scope="col">Estratégia</th>
                                        <th scope="col">Eixo</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Data de referência</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in dados.registros %}
                                        {% set statusClasses = {
                                            'Concluído': 'status-toast-success',
                                            'Em andamento': 'status-toast-warning',
                                            'Não iniciado': 'status-toast-danger',
                                            'cancelado': 'status-toast-danger'
                                        } %}
                                        <tr class="bsc-data-row">
                                            <td class="data-table-id">{{ row.id }}</td>
                                            <td class="data-table-strategy">{{ row.estrategia }}</td>
                                            <td class="data-table-axis">{{ row.eixo }}</td>
                                            <td>
                                                <span class="status-toast {{ statusClasses[row.situacao] ?? '' }}">
                                                    {{ row.situacao }}
                                                </span>
                                            </td>
                                            <td class="data-table-date">{{ row.data_referencia ? row.data_referencia|date('d/m/Y') : '-' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-secondary py-4">
                                                Nenhum registro encontrado.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                            <div class="data-table-pagination" id="bscTablePagination">
                                <div class="data-table-progress" aria-hidden="true">
                                    <div class="data-table-progress-bar" id="bscTableProgress"></div>
                                </div>
                                <div class="data-table-actions">
                                    <button class="data-table-btn" type="button" id="bscTablePrev" aria-label="Página anterior">&lsaquo;</button>
                                    <button class="data-table-btn" type="button" id="bscTableNext" aria-label="Próxima página">&rsaquo;</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            {% endblock graphics %}
        </div>
</div>   




    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@0.7.0"></script>
    <script src="/public/assets/other/js/graficos.js"></script>
    <script src="/public/assets/other/js/theme-manager.js"></script>

    <script>
        const grafico_eixo = {{ dados.situacao|json_encode|raw }};
        const isMobile = window.innerWidth <= 576;
        const pieOptions = isMobile
            ? {
                showLegend: false,
                datalabelOffset: 6
            }
            : {
                showLegend: true,
                legendPosition: 'right',
                datalabelOffset: 8
            };

        createChart('graficoEixo', grafico_eixo, 'situacao', 'pie', 'total', pieOptions);
    </script>

    <script>
        const grafico_eixoBar = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBar', grafico_eixoBar, 'eixo', 'bar', 'total', {
            showLegend: false
        });
    </script>

    <script>
        const grafico_eixoBarHorizon = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBarHorizon', grafico_eixoBarHorizon, 'eixo', 'horizontalBar', 'total', {
            showLegend: false,
            datalabelAlign: 'right',
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = Array.from(document.querySelectorAll('.bsc-data-row'));
            const card = document.querySelector('.data-table-card');
            const header = document.querySelector('.data-table-header');
            const tableHead = document.querySelector('.data-table thead');
            const pageInfo = document.getElementById('bscTablePageInfo');
            const progress = document.getElementById('bscTableProgress');
            const pagination = document.getElementById('bscTablePagination');
            const prevButton = document.getElementById('bscTablePrev');
            const nextButton = document.getElementById('bscTableNext');

            if (!rows.length || !pageInfo || !progress || !pagination || !prevButton || !nextButton) {
                if (pagination) {
                    pagination.style.display = 'none';
                }
                if (pageInfo) {
                    pageInfo.textContent = '0/0';
                }
                return;
            }

            const getRowsPerPage = function () {
                if (card && header && tableHead && pagination) {
                    const cardStyle = window.getComputedStyle(card);
                    const cardPadding = parseFloat(cardStyle.paddingTop) + parseFloat(cardStyle.paddingBottom);
                    const availableHeight = card.clientHeight - cardPadding - header.offsetHeight - tableHead.offsetHeight - pagination.offsetHeight - 38;
                    const visibleRow = rows.find(function (row) {
                        return !row.hidden;
                    }) || rows[0];
                    const rowHeight = visibleRow.offsetHeight || 72;
                    const calculatedRows = Math.floor(availableHeight / rowHeight);

                    return Math.max(4, Math.min(8, calculatedRows));
                }

                if (window.innerWidth < 992) {
                    return 4;
                }

                return window.innerHeight >= 1000 ? 6 : 5;
            };

            let rowsPerPage = getRowsPerPage();
            let totalPages = Math.ceil(rows.length / rowsPerPage);
            let currentPage = 0;
            let rotationTimer = null;

            const renderPage = function () {
                const start = currentPage * rowsPerPage;
                const end = start + rowsPerPage;

                rows.forEach(function (row, index) {
                    row.hidden = index < start || index >= end;
                });

                pageInfo.textContent = (currentPage + 1) + '/' + totalPages;
                progress.style.width = (((currentPage + 1) / totalPages) * 100) + '%';
                pagination.style.display = totalPages > 1 ? 'flex' : 'none';
            };

            const goToPage = function (direction) {
                currentPage = (currentPage + direction + totalPages) % totalPages;
                renderPage();
            };

            const startRotation = function () {
                window.clearInterval(rotationTimer);

                if (totalPages > 1) {
                    rotationTimer = window.setInterval(function () {
                        goToPage(1);
                    }, 8500);
                }
            };

            const resetRotation = function () {
                startRotation();
            };

            prevButton.addEventListener('click', function () {
                goToPage(-1);
                resetRotation();
            });

            nextButton.addEventListener('click', function () {
                goToPage(1);
                resetRotation();
            });

            window.addEventListener('resize', function () {
                const nextRowsPerPage = getRowsPerPage();

                if (nextRowsPerPage === rowsPerPage) {
                    return;
                }

                rowsPerPage = nextRowsPerPage;
                totalPages = Math.ceil(rows.length / rowsPerPage);
                currentPage = Math.min(currentPage, totalPages - 1);
                renderPage();
                startRotation();
            });

            renderPage();
            startRotation();
        });
    </script>
    {% block js %}
        
    {% endblock js %}
</body>
</html>
