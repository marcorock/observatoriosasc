<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - {{ system|default(name|default('Observatório')) }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    {# <link rel="stylesheet" href="/../public/assets/main/css/style.css"> #}
    {% block head_assets %}
    {% endblock head_assets %}

    {# <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script> #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <style>
        body {
            background-color: #0f172a; /* Tom escuro similar à imagem */
            color: #f8fafc;
        }
        .card-custom {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            height: 100%;
        }
        /* Ajuste para garantir preenchimento em telas 1080p */
        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 16px 20px;
            }
            .row-flexible { flex: 1; }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
    </style>
    <style>
        :root {
            --app-bg: #0f172a;
            --app-text: #f8fafc;
            --card-bg: #1e293b;
            --card-border: #334155;
            --muted-text: #7f8aa3;
        }

        body {
            background-color: var(--app-bg);
            color: var(--app-text);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .card-custom {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            height: 100%;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .brand-subtitle,
        .meta-pill,
        .text-muted-custom {
            color: var(--muted-text);
        }

        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 16px 20px;
            }

            .row-flexible {
                flex: 1;
            }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
        .theme-icon {
            font-size: 14px;
            line-height: 1;
        }

        .data-table-card {
            display: flex;
            min-height: 100%;
            overflow: hidden;
        }

        .data-table-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 18px;
        }

        .data-table-title {
            margin: 0;
            font-size: clamp(1.25rem, 1.45vw, 1.65rem);
            font-weight: 800;
            letter-spacing: 0;
        }

        .data-table-subtitle {
            display: block;
            margin-top: 4px;
            color: var(--muted-text);
            font-size: clamp(0.9rem, 0.9vw, 1.05rem);
        }

        .data-table-page {
            min-width: 92px;
            padding: 8px 12px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.58);
            color: #dbeafe;
            font-size: clamp(0.95rem, 0.9vw, 1.1rem);
            font-weight: 700;
            text-align: center;
        }

        .data-table-shell {
            overflow-x: auto;
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.45);
        }

        .data-table {
            min-width: 760px;
            border-collapse: separate;
            border-spacing: 0;
            color: var(--app-text);
        }

        .data-table thead th {
            padding: 16px 18px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.24);
            background: rgba(30, 41, 59, 0.92);
            color: #94a3b8;
            font-size: clamp(0.82rem, 0.82vw, 0.98rem);
            font-weight: 800;
            text-transform: uppercase;
        }

        .data-table tbody td {
            padding: 17px 18px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.12);
            font-size: clamp(1rem, 1vw, 1.18rem);
            vertical-align: middle;
        }

        .data-table tbody tr {
            background: rgba(30, 41, 59, 0.38);
        }

        .data-table tbody tr:nth-child(even) {
            background: rgba(51, 65, 85, 0.28);
        }

        .data-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .data-table-id {
            width: 72px;
            color: #93c5fd;
            font-weight: 800;
        }

        .data-table-strategy {
            max-width: 360px;
            color: #f8fafc;
            font-weight: 700;
            line-height: 1.28;
        }

        .data-table-axis,
        .data-table-date {
            color: #cbd5e1;
            font-weight: 650;
            white-space: nowrap;
        }

        .data-table-pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 16px;
        }

        .data-table-progress {
            flex: 1;
            height: 8px;
            overflow: hidden;
            border-radius: 999px;
            background: rgba(148, 163, 184, 0.18);
        }

        .data-table-progress-bar {
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #38bdf8, #22c55e);
            transition: width 0.25s ease;
        }

        .data-table-actions {
            display: flex;
            gap: 8px;
        }

        .data-table-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            border-radius: 8px;
            background: rgba(15, 23, 42, 0.62);
            color: #e2e8f0;
            font-size: 1.35rem;
            line-height: 1;
        }

        .data-table-btn:hover,
        .data-table-btn:focus {
            border-color: rgba(56, 189, 248, 0.75);
            color: #7dd3fc;
        }

        .status-toast {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 146px;
            padding: 8px 12px;
            border-radius: 8px;
            border-left: 4px solid var(--bs-secondary);
            background: rgba(var(--bs-secondary-rgb), 0.18);
            color: var(--app-text);
            font-size: clamp(0.95rem, 0.9vw, 1.08rem);
            font-weight: 800;
            white-space: nowrap;
        }

        .status-toast-success {
            border-left-color: var(--bs-success);
            background: rgba(var(--bs-success-rgb), 0.18);
            color: #8ee6ad;
        }

        .status-toast-warning {
            border-left-color: var(--bs-warning);
            background: rgba(var(--bs-warning-rgb), 0.18);
            color: #ffe08a;
        }

        .status-toast-danger {
            border-left-color: var(--bs-danger);
            background: rgba(var(--bs-danger-rgb), 0.18);
            color: #ff9aa8;
        }

        @media (max-width: 991.98px) {
            .data-table-card {
                min-height: auto;
            }

            .data-table {
                min-width: 680px;
            }

            .data-table-header,
            .data-table-pagination {
                align-items: stretch;
                flex-direction: column;
            }

            .data-table-page {
                width: 100%;
            }
        }
    </style>
</head>
<body>

<div class="container-fluid full-hd-container">
    {# {% block main %} #}
        <!--FIRST-LINE-HEADER-APPLICATION-->
        {% block header %}    
            {% include "a_modulos/app_header.twig" %}
        {% endblock header %}

        {% block main %}
            
        {% endblock main %}


    {# {% endblock main %} #}
</div>   

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/other/js/theme-manager.js"></script>
    {% block js %}
        
    {% endblock js %}
    {% include "a_modulos/navigation_loader.twig" %}
</body>
</html>
