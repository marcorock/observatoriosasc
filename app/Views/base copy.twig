<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - {{system}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    {# <link rel="stylesheet" href="/../public/assets/main/css/style.css"> #}

    {# <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script> #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <style>
        body {
            background-color: #0f172a; /* Tom escuro similar à imagem */
            color: #f8fafc;
        }
        .card-custom {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            height: 100%;
        }
        /* Ajuste para garantir preenchimento em telas 1080p */
        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }
            .row-flexible { flex: 1; }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
    </style>
    <style>
        :root {
            --app-bg: #0f172a;
            --app-text: #f8fafc;
            --card-bg: #1e293b;
            --card-border: #334155;
            --muted-text: #7f8aa3;
        }

        body {
            background-color: var(--app-bg);
            color: var(--app-text);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .card-custom {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            height: 100%;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .brand-subtitle,
        .meta-pill,
        .text-muted-custom {
            color: var(--muted-text);
        }

        @media (min-width: 1200px) {
            .full-hd-container {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }

            .row-flexible {
                flex: 1;
            }
        }

        .card-custom,
        .col,
        .row-flexible,
        canvas {
            overflow: visible;
        }
        .theme-icon {
            font-size: 14px;
            line-height: 1;
        }

        .status-toast {
            display: inline-flex;
            align-items: center;
            min-width: 120px;
            padding: 6px 10px;
            border-radius: 8px;
            border-left: 4px solid var(--bs-secondary);
            background: rgba(var(--bs-secondary-rgb), 0.18);
            color: var(--app-text);
            font-weight: 600;
            white-space: nowrap;
        }

        .status-toast-success {
            border-left-color: var(--bs-success);
            background: rgba(var(--bs-success-rgb), 0.18);
            color: #8ee6ad;
        }

        .status-toast-warning {
            border-left-color: var(--bs-warning);
            background: rgba(var(--bs-warning-rgb), 0.18);
            color: #ffe08a;
        }

        .status-toast-danger {
            border-left-color: var(--bs-danger);
            background: rgba(var(--bs-danger-rgb), 0.18);
            color: #ff9aa8;
        }
    </style>
</head>
<body>

<div class="container-fluid full-hd-container">
    {# {% block main %} #}
        <!--FIRST-LINE-HEADER-APPLICATION-->
        {% block header %}    
            <header class="row mb-3 g-2">
                <div class="col-12">
                    <div class="card-custom p-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h4 class="mb-0">MODO TV: {{title}}</h4>
                                <small class="text-secondary">{{description}}</small>
                            </div>
                            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                <div class="row g-2 justify-content-md-end">
                                    <div class="col-auto"><span class="badge bg-primary">Mês: Setembro</span></div>
                                    <div class="col-auto"><span class="badge bg-success">Status: Ativo</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
        {% endblock header %}

        <!--SECOND-LINE-CARDS-TOTAL-->
        <div class="row row-cols-1 row-cols-md-3 row-cols-xl-4 g-3 mb-3">
        {% block cards %}
                <div class="col">
                    <div class="card-custom p-3 text-center">
                        <small class="text-uppercase text-secondary">TOTAL </small>
                        <h2 class="fw-bold mb-0">{{dados.total_geral ?? NULL}}</h2>
                    </div>
                </div>
                {% for row in dados.situacao %}
                    {% if row.situacao == 'Concluído' %}  
                        <div class="col">
                            <div class="card-custom p-3 text-center border-start border-primary border-4">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-success">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}   
                    {% if row.situacao == 'Em andamento' %}      
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-warning">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %} 
                    {# Não iniciado #}
                    {% if row.situacao == 'Não iniciado' %} 
                        <div class="col">
                            <div class="card-custom p-3 text-center">
                                <small class="text-uppercase text-secondary">{{row.situacao}}</small>
                                <h2 class="fw-bold mb-0 text-danger">{{row.total}}</h2>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endblock cards %}
        </div>  
        

        <!-- LINE-MAPS-GRAPHICS -->
        <div class="row row-cols-1 row-cols-lg-2 g-3 mb-3 row-flexible">
            {% block graphics %}   
                <div class="col">

                    <div class="col">
                        <div class="card-custom p-3">
                            <h6>Distribuição Por eixo</h6>
                            <div class="d-flex align-items-center justify-content-center" style="min-height: 300px;">
                                <canvas id="graficoEixo"></canvas>
                                {# graficoEixoBar #}
                            </div>
                        </div>
                    </div>
                    <div class="col mt-3">
                        <div class="card-custom p-3">
                            <h6>Distribuição Por eixo</h6>
                            <div class="d-flex align-items-center justify-content-center" style="min-height: 350px;">
                                <canvas id="graficoEixoBar"></canvas>
                            </div>
                        </div>
                    </div>

                </div> 

                <div class="col">
                    <div class="card-custom p-3">
                        <h6>Tabela de dados</h6>
                        <div class="table-responsive mt-3">
                            <table class="table table-dark table-hover table-sm align-middle small mb-0">
                                <thead>
                                    <tr>
                                        {# <th scope="col">ID</th> #}
                                        <th scope="col">Estratégia</th>
                                        <th scope="col">Eixo</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Data de referência</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in dados.registros %}
                                        {% set statusClasses = {
                                            'Concluído': 'status-toast-success',
                                            'Em andamento': 'status-toast-warning',
                                            'Não iniciado': 'status-toast-danger',
                                            'cancelado': 'status-toast-danger'
                                        } %}
                                        <tr>
                                            {# <td>{{ row.id }}</td> #}
                                            <td>{{ row.estrategia }}</td>
                                            <td>{{ row.eixo }}</td>
                                            <td>
                                                <span class="status-toast {{ statusClasses[row.situacao] ?? '' }}">
                                                    {{ row.situacao }}
                                                </span>
                                            </td>
                                            <td>{{ row.data_referencia ? row.data_referencia|date('d/m/Y') : '-' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-secondary py-4">
                                                Nenhum registro encontrado.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                {# <div class="col">
                    <div class="card-custom p-3">
                        <h6>Distribuição Por eixo</h6>
                        <div class="d-flex align-items-center justify-content-center" style="min-height: auto;">
                            <canvas id="graficoEixoBarHorizon"></canvas>
                        </div>
                    </div>
                </div> #}
            {% endblock graphics %}
        </div>

        <!-- LINE-TABLES-AND-OTHER-INFORMATION -->
        {# <div class="row row-cols-1 row-cols-lg-3 g-3 row-flexible">
            {% block info %}
                <div class="col">
                    <div class="card-custom p-3">
                        <h6>Atendimentos por Unidade</h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-sm small">
                                <thead>
                                    <tr><th>CRAS</th><th>Total</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Alto da Ponte</td><td>74</td></tr>
                                    <tr><td>Anhembi</td><td>34</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card-custom p-3">
                        <h6>Renda Per Capita</h6>
                        <div class="mt-2">
                            <div class="mb-2 small">Renda 0.00: <div class="bg-warning text-dark p-1" style="width: 90%">27.538</div></div>
                            <div class="mb-2 small">Até 1/4 SM: <div class="bg-warning text-dark p-1" style="width: 60%">16.252</div></div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card-custom p-3 text-center">
                        <h6>Faixa Etária Agrupada</h6>
                        <div class="mt-4 text-muted small">Gráfico de Barras Detalhado</div>
                    </div>
                </div>
            {% endblock info %}
        </div> #}

    {# {% endblock main %} #}
</div>   




    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@0.7.0"></script>
    <script src="/public/assets/other/js/graficos.js"></script>
    <script src="/public/assets/other/js/theme-manager.js"></script>

    <script>
        const grafico_eixo = {{ dados.situacao|json_encode|raw }};
        const isMobile = window.innerWidth <= 576;
        const pieOptions = isMobile
            ? {
                showLegend: false,
                datalabelOffset: 6
            }
            : {
                showLegend: true,
                legendPosition: 'right',
                datalabelOffset: 8
            };

        createChart('graficoEixo', grafico_eixo, 'situacao', 'pie', 'total', pieOptions);
    </script>

    <script>
        const grafico_eixoBar = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBar', grafico_eixoBar, 'eixo', 'bar', 'total', {
            showLegend: false
        });
    </script>

    <script>
        const grafico_eixoBarHorizon = {{ dados.eixo|json_encode|raw }};
        createChart('graficoEixoBarHorizon', grafico_eixoBarHorizon, 'eixo', 'horizontalBar', 'total', {
            showLegend: false,
            datalabelAlign: 'right',
        });
    </script>
    {% block js %}
        
    {% endblock js %}
</body>
</html>
