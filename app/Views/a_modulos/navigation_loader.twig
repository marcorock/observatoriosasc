<div
    id="appNavigationLoader"
    class="app-navigation-loader"
    role="status"
    aria-live="polite"
    aria-hidden="true"
>
    <div class="app-navigation-loader__panel">
        <span class="app-navigation-loader__spinner" aria-hidden="true"></span>
        <strong>Carregando...</strong>
        <span>Aguarde enquanto preparamos a próxima tela.</span>
    </div>
</div>

<style>
    .app-navigation-loader {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: grid;
        place-items: center;
        padding: 24px;
        background: rgba(15, 23, 42, 0.78);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.16s ease, visibility 0.16s ease;
        backdrop-filter: blur(5px);
    }

    .app-navigation-loader.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .app-navigation-loader__panel {
        display: flex;
        width: min(100%, 340px);
        align-items: center;
        flex-direction: column;
        gap: 10px;
        padding: 28px 24px;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.3);
        color: #12355b;
        text-align: center;
    }

    .app-navigation-loader__panel strong {
        font-size: 1.2rem;
    }

    .app-navigation-loader__panel span:last-child {
        color: #5f6f82;
        font-size: 0.94rem;
    }

    .app-navigation-loader__spinner {
        width: 42px;
        height: 42px;
        border: 4px solid #dbeafe;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: app-navigation-loader-spin 0.75s linear infinite;
    }

    @keyframes app-navigation-loader-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .app-navigation-loader,
        .app-navigation-loader__spinner {
            transition: none;
            animation-duration: 1.5s;
        }
    }
</style>

<script>
    (function () {
        const loader = document.getElementById('appNavigationLoader');

        if (!loader) {
            return;
        }

        let navigating = false;

        const hideLoader = function () {
            navigating = false;
            loader.classList.remove('is-visible');
            loader.setAttribute('aria-hidden', 'true');
            document.body.removeAttribute('aria-busy');
        };

        const showLoader = function () {
            navigating = true;
            loader.classList.add('is-visible');
            loader.setAttribute('aria-hidden', 'false');
            document.body.setAttribute('aria-busy', 'true');
        };

        const isInternalNavigation = function (event, link) {
            if (event.defaultPrevented
                || event.button !== 0
                || event.metaKey
                || event.ctrlKey
                || event.shiftKey
                || event.altKey
                || link.target === '_blank'
                || link.hasAttribute('download')
                || link.dataset.navigationLoader === 'off') {
                return false;
            }

            const href = link.getAttribute('href');

            if (!href || href.startsWith('#') || href.startsWith('javascript:')) {
                return false;
            }

            const destination = new URL(link.href, window.location.href);

            if (!['http:', 'https:'].includes(destination.protocol)
                || destination.origin !== window.location.origin) {
                return false;
            }

            return destination.href !== window.location.href;
        };

        document.addEventListener('click', function (event) {
            const link = event.target.closest('a[href]');

            if (!link || !isInternalNavigation(event, link)) {
                return;
            }

            event.preventDefault();

            if (navigating) {
                return;
            }

            showLoader();
            const destination = link.href;

            window.setTimeout(function () {
                window.location.assign(destination);
            }, 80);
        });

        window.addEventListener('pageshow', hideLoader);
    })();
</script>
