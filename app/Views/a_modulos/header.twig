<style>
    .dashboard-header.card-custom {
        height: auto;
        min-height: 0;
    }

    .dashboard-header-layout {
        display: flex;
        align-items: center;
        gap: 24px;
        width: 100%;
    }

    .dashboard-header-main {
        flex: 0 0 calc(70% - 12px);
        max-width: calc(70% - 12px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        min-height: 0;
    }

    .dashboard-header-controls {
        flex: 0 0 calc(30% - 12px);
        max-width: calc(30% - 12px);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
        min-width: 360px;
        min-height: 0;
    }

    .dashboard-header .brand-title {
        max-width: 980px;
        font-size: clamp(1.7rem, 2.2vw, 2.9rem);
        line-height: 1.14;
    }

    .dashboard-filter-modal {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(2, 6, 23, 0.72);
    }

    .dashboard-filter-modal.is-visible {
        display: flex;
    }

    .dashboard-filter-dialog {
        width: min(560px, 100%);
        padding: 10px;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 8px;
        background: var(--card-bg);
        box-shadow: 0 22px 64px rgba(0, 0, 0, 0.38);
    }

    .dashboard-filter-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        padding: 4px 4px 0;
    }

    .dashboard-filter-titlebar h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
    }

    .dashboard-period-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .dashboard-period-actions,
    .dashboard-global-action,
    .dashboard-period-status {
        grid-column: 1 / -1;
    }

    .dashboard-period-actions,
    .header-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dashboard-period-actions .btn {
        flex: 1 1 120px;
    }

    .dashboard-header-controls .form-label,
    .dashboard-period-status {
        color: var(--muted-text);
    }

    .dashboard-period-pill {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @media (max-width: 1199.98px) {
        .dashboard-header-layout {
            flex-direction: column;
        }

        .dashboard-header-main,
        .dashboard-header-controls {
            flex-basis: auto;
            max-width: 100%;
            min-width: 0;
        }
    }

    @media (max-width: 575.98px) {
        .dashboard-period-form {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dashboard-header container-fluid py-3 px-3 px-lg-4 border-bottom card-custom mb-3">
    <div class="dashboard-header-layout">

        <div class="dashboard-header-main">
            <h1 class="brand-title mb-1">
                📺 MODO TV: {{ name }}
            </h1>
            <p class="brand-subtitle mb-0">
                {{ description }} - {{saudacao()}}
            </p>
        </div>

        <div class="dashboard-header-controls">
            <div class="header-meta justify-content-start justify-content-xl-end">
                <button id="dashboardFilterToggle"
                    class="meta-pill btn btn-sm btn-outline-primary d-flex align-items-center gap-1"
                    type="button"
                    aria-expanded="false"
                    aria-controls="dashboardPeriodForm"
                    title="Mostrar filtro de período">
                    <span aria-hidden="true">⚙</span>
                </button>

                <button id="themeToggleBtn"
                    class="meta-pill btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                    type="button"
                    aria-label="Alternar tema">
                    <span class="theme-icon">🌙</span>
                    <span class="theme-label d-none d-sm-inline">Modo Escuro</span>
                </button>

                <!--Botão para trocar entre tabela e graficos -->
                <button id="viewToggleBtn" 
                class="meta-pill btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                type="button">
                    <i class="bi bi-table"></i> Alternar para Tabela
                </button>



                <a href="{{ url('bsc/registros') }}"
                    class="meta-pill btn btn-sm btn-outline-info d-flex align-items-center gap-1">
                    Registros
                </a>

                <div class="meta-pill badge text-bg-light px-3 py-2 dashboard-period-pill" id="dashboardPeriodPill">
                    📅
                    {% if periodo.data_inicio and periodo.data_fim %}
                        {{ periodo.data_inicio|date('d/m/Y') }} à {{ periodo.data_fim|date('d/m/Y') }}
                    {% elseif periodo.data_inicio %}
                        A partir de {{ periodo.data_inicio|date('d/m/Y') }}
                    {% elseif periodo.data_fim %}
                        Até {{ periodo.data_fim|date('d/m/Y') }}
                    {% else %}
                        Sem filtro
                    {% endif %}
                </div>

                {% set cores = {
                    'Concluído': 'success',
                    'Em andamento': 'warning',
                    'Não iniciado': 'danger'
                } %}

                {% set color = cores[status] ?? 'secondary' %}

                <div class="meta-pill badge text-bg-{{ color }} px-3 py-2">
                    Status: {{ status ?? 'Em Desenvolvimento' }}
                </div>
            </div>
        </div>

    </div>
</div>

<div class="dashboard-filter-modal" id="dashboardFilterModal" aria-hidden="true">
    <div class="dashboard-filter-dialog">
        <div class="dashboard-filter-titlebar">
            <h2>Filtro de período</h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="dashboardFilterClose" aria-label="Fechar filtro">
                ×
            </button>
        </div>
        <form id="dashboardPeriodForm"
            class="dashboard-period-form"
            data-local-url="{{ url('bsc/filter/local') }}"
            data-clear-local-url="{{ url('bsc/filter/local/clear') }}"
            data-global-url="{{ url('bsc/filter/global') }}"
            data-data-url="{{ url('bsc/dashboard-data') }}"
            data-is-admin="{{ is_admin ? '1' : '0' }}">
            <div>
                <label for="dashboardDataInicio" class="form-label small mb-1">Data início</label>
                <input type="date"
                    class="form-control form-control-sm"
                    id="dashboardDataInicio"
                    name="data_inicio"
                    value="{{ periodo.data_inicio ?? '' }}">
            </div>
            <div>
                <label for="dashboardDataFim" class="form-label small mb-1">Data fim</label>
                <input type="date"
                    class="form-control form-control-sm"
                    id="dashboardDataFim"
                    name="data_fim"
                    value="{{ periodo.data_fim ?? '' }}">
            </div>
            <div class="dashboard-period-actions">
                <button type="button" class="btn btn-sm btn-primary flex-fill" id="dashboardApplyLocal">
                    Aplicar
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" id="dashboardClearLocal">
                    Limpar
                </button>
            </div>
            {% if is_admin %}
                <div class="dashboard-global-action">
                    <button type="button" class="btn btn-sm btn-outline-warning w-100" id="dashboardApplyGlobal">
                        Salvar período global
                    </button>
                </div>
            {% endif %}
            <div class="dashboard-period-status">
                <small id="dashboardPeriodStatus">
                    Filtro ativo: {{ periodo.tipo == 'local' ? 'local' : (periodo.tipo == 'global' ? 'global' : 'sem filtro') }}
                </small>
            </div>
        </form>
    </div>
</div>
